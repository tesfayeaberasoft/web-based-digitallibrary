# Digital Library System Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
APP_DEBUG=false
APP_VERSION=1.0.0
APP_BASE_URL=https://your-site.example
# Optional; defaults to APP_BASE_URL/backend in production.
API_PUBLIC_URL=https://your-site.example/backend

# Database Configuration
DB_HOST=your_infinityfree_mysql_host
DB_NAME=your_infinityfree_database_name
DB_USER=your_infinityfree_database_user
DB_PASS=your_infinityfree_database_password

# SendGrid Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Digital Library System
REPLY_TO_EMAIL=support@yourdomain.com

# Google Books API (optional; keep this key server-side)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid
SMS_API_SECRET=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

# Library Settings
DEFAULT_LOAN_PERIOD=14
MAX_RENEWALS=2
LATE_FEE_PER_DAY=0.50
MAX_RESERVATIONS_PER_USER=5

# ============================================================================
# CHAPA PAYMENT GATEWAY CONFIGURATION
# ============================================================================
# Get your API keys from: https://dashboard.chapa.co/
# Test Mode: Use test API key for development/testing
# Live Mode: Use live API key for production

# Chapa API Keys
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key

# Chapa Settings
CHAPA_MODE=test
CHAPA_CURRENCY=ETB

# Chapa Webhook/Callback URLs
# These URLs must be publicly accessible for Chapa to send callbacks
# For local development, use ngrok or similar tunneling service
CHAPA_CALLBACK_URL=https://your-site.example/backend/api/payments/callback
CHAPA_RETURN_URL=https://your-site.example/payment/return

# Comma-separated list of frontend origins allowed to make cross-origin API calls.
# Same-origin frontend/API deployments do not require CORS.
CORS_ALLOWED_ORIGINS=https://your-site.example

# Payment Settings
PAYMENT_MIN_AMOUNT=1.00
PAYMENT_MAX_AMOUNT=10000.00
PAYMENT_TIMEOUT=1800