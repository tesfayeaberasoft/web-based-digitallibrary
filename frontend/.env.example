# Copy this file to .env and fill in your values

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=22900232380-bu194bg29pvdauj1ac9tu5i588onh6u8.apps.googleusercontent.com

# Backend API base URL (development default). Production uses the backend
# subdirectory on the same origin; see .env.production.example.
REACT_APP_API_URL=http://localhost:8000

# Google Books API keys must only be configured in backend/.env.
# Never add a private API key to this frontend environment file.
# ============================================================================
# CHAPA PAYMENT GATEWAY CONFIGURATION (FRONTEND)
# ============================================================================
# Note: Only the public key is needed in frontend
# The secret key should NEVER be exposed in frontend code

# Chapa Public Key (public key only; never put the secret key in frontend env)
REACT_APP_CHAPA_PUBLIC_KEY=your_chapa_public_key

# Payment Configuration
REACT_APP_PAYMENT_CURRENCY=ETB
REACT_APP_PAYMENT_MIN_AMOUNT=1.00
