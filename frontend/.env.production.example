# Copy to frontend/.env.production.local, replace the host, then build.
# The PHP backend is deployed in the /backend subdirectory on the same origin.
REACT_APP_API_URL=https://your-site.example/backend
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id
REACT_APP_CHAPA_PUBLIC_KEY=your_chapa_public_key
